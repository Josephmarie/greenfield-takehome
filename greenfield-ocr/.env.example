# ── OCR pipeline + auth + lead capture ───────────────────────────────────────
# Copy to .env and fill in. In production these are set on the Render service
# (dashboard / API), never committed.

# Required — Claude vision for the OCR pipeline
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional model override
GREENFIELD_MODEL=claude-sonnet-4-6

# Postgres (Render managed). Required for /runs, signup/login, and leads.
# Optional locally — leave blank to run the pipeline without persistence.
DATABASE_URL=

# Auth — stable JWT signing secret. If unset, a random per-boot value is used
# (tokens then break on every restart). Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Google Sheet lead mirror (OPTIONAL — leads always save to Postgres regardless).
# Leave GOOGLE_SHEET_ID blank to disable. When set, also mount a Google
# service-account JSON at /etc/secrets/google_credentials.json (or
# greenfield-ocr/google_credentials.json locally) and share the sheet with that
# service-account email. The id is the long token in the sheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
